# Maintainer: PatchCraft <support@patchcraft.dev>
pkgname=patchcraft-launcher-bin
_pkgname=patchcraft-launcher
pkgver=2.0.1
pkgrel=1
pkgdesc="PatchCraft Launcher — unofficial native Linux launcher for RuneScape & Jagex Accounts"
arch=('x86_64')
url="https://launcher.patchcraft.dev/"
license=('custom:proprietary')
depends=(
  'gtk3'
  'nss'
  'libxss'
  'libxtst'
  'xdg-utils'
  'at-spi2-core'
  'libdrm'
  'mesa'
  'alsa-lib'
  'tar'
  'xz'
)
optdepends=(
  'java-runtime: Java runtime required to play RuneLite and HDOS'
  'gamemode: Feral GameMode support for CPU governor and process scheduling'
  'mangohud: Real-time hardware and FPS overlay'
)
provides=('patchcraft-launcher' 'linux-jagex-launcher' 'jagex-launcher')
conflicts=('patchcraft-launcher' 'linux-jagex-launcher' 'jagex-launcher')
replaces=('linux-jagex-launcher-bin')
source=("https://github.com/cook0001/Patchcraft-Launcher/releases/download/v${pkgver}/${_pkgname}_${pkgver}_amd64.deb")
sha256sums=('f4bccd598f591f1d1e781b5cb8ec9e2d3a78b38e68dc019efa0c6c97eecc36a0')

package() {
  # Extract the deb payload
  bsdtar -xf data.tar.xz -C "${pkgdir}"

  # Support both PatchCraft Launcher (new) and legacy Jagex Launcher payload paths
  local app_dir="/opt/PatchCraft Launcher"
  if [ ! -d "${pkgdir}${app_dir}" ] && [ -d "${pkgdir}/opt/Jagex Launcher" ]; then
    app_dir="/opt/Jagex Launcher"
  fi
  local bin_name="patchcraft-launcher"
  if [ ! -f "${pkgdir}${app_dir}/${bin_name}" ] && [ -f "${pkgdir}${app_dir}/linux-jagex-launcher" ]; then
    bin_name="linux-jagex-launcher"
  fi

  # Fix permissions
  find "${pkgdir}" -type d -exec chmod 755 {} +
  chmod 755 "${pkgdir}${app_dir}/${bin_name}"

  # Symlink to /usr/bin for terminal execution (including legacy aliases)
  install -dm755 "${pkgdir}/usr/bin"
  ln -sf "${app_dir}/${bin_name}" "${pkgdir}/usr/bin/patchcraft-launcher"
  ln -sf "${app_dir}/${bin_name}" "${pkgdir}/usr/bin/linux-jagex-launcher"
  ln -sf "${app_dir}/${bin_name}" "${pkgdir}/usr/bin/jagex-launcher"

  # Ensure app and Electron/Chromium third-party licenses are installed
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  if [ -f "${pkgdir}/usr/share/doc/${_pkgname}/copyright" ]; then
    install -Dm644 "${pkgdir}/usr/share/doc/${_pkgname}/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  elif [ -f "${pkgdir}/usr/share/doc/jagex-launcher/copyright" ]; then
    install -Dm644 "${pkgdir}/usr/share/doc/jagex-launcher/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
  if [ -f "${pkgdir}${app_dir}/LICENSE.electron.txt" ]; then
    install -Dm644 "${pkgdir}${app_dir}/LICENSE.electron.txt" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  fi
  if [ -f "${pkgdir}${app_dir}/LICENSES.chromium.html" ]; then
    install -Dm644 "${pkgdir}${app_dir}/LICENSES.chromium.html" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"
  fi
}
