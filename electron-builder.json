{
  "appId": "com.jagex.launcher.linux",
  "productName": "Jagex Launcher",
  "directories": {
    "output": "release"
  },
  "toolsets": {
    "appimage": "1.0.3"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "resources/**/*"
  ],
  "protocols": [
    {
      "name": "Jagex Launcher Protocol",
      "schemes": [
        "jagex",
        "runescape"
      ]
    }
  ],
  "linux": {
    "syncDesktopName": true,
    "target": [
      "AppImage",
      "deb",
      "tar.gz",
      "rpm",
      "pacman"
    ],
    "category": "Game",
    "icon": "resources/icon.png",
    "desktop": {
      "entry": {
        "StartupWMClass": "linux-jagex-launcher",
        "Keywords": "runescape;osrs;jagex;runelite;hdos;game;",
        "Comment": "Authentic, native Jagex Launcher for Linux (RuneScape 3 & Old School RuneScape)",
        "Categories": "Game;"
      }
    }
  },
  "appImage": {
    "artifactName": "Jagex-Launcher-${version}.${ext}"
  },
  "deb": {
    "packageName": "jagex-launcher",
    "artifactName": "jagex-launcher_${version}_${arch}.${ext}",
    "fpm": [
      "--replaces=linux-jagex-launcher",
      "--conflicts=linux-jagex-launcher",
      "--provides=linux-jagex-launcher"
    ],
    "category": "games",
    "priority": "optional",
    "synopsis": "Authentic, native Jagex Launcher for Linux",
    "description": "Authentic, native Jagex Launcher for Linux supporting RuneScape 3 and Old School RuneScape (RuneLite, HDOS, and Official client) with direct OAuth 2.0 PKCE authentication.",
    "maintainer": "Daniel Cook <danielcook2016@outlook.com>",
    "depends": [
      "libgtk-3-0 | libgtk-3-0t64",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64 | libatspi2.0-0 | libatspi-0",
      "libdrm2",
      "libgbm1",
      "libasound2 | libasound2t64",
      "tar",
      "xz-utils"
    ],
    "recommends": [
      "default-jre",
      "gamemode"
    ]
  },
  "snapcraft": {
    "base": "core22",
    "core22": {
      "artifactName": "linux-jagex-launcher_${version}_${arch}.${ext}",
      "grade": "stable",
      "confinement": "strict",
      "summary": "Authentic, native Jagex Launcher for Linux",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "x11",
        "wayland",
        "unity7",
        "browser-support",
        "network",
        "network-bind",
        "gsettings",
        "audio-playback",
        "pulseaudio",
        "opengl",
        "removable-media",
        "joystick",
        "process-control"
      ]
    }
  },
  "rpm": {
    "packageName": "linux-jagex-launcher",
    "artifactName": "linux-jagex-launcher-${version}.${arch}.${ext}",
    "category": "Amusements/Games",
    "synopsis": "Authentic, native Jagex Launcher for Linux",
    "description": "Authentic, native Jagex Launcher for Linux supporting RuneScape 3 and Old School RuneScape (RuneLite, HDOS, and Official client) with direct OAuth 2.0 PKCE authentication.",
    "fpm": [
      "--replaces=jagex-launcher",
      "--conflicts=jagex-launcher",
      "--provides=jagex-launcher"
    ],
    "depends": [
      "gtk3",
      "nss",
      "libXScrnSaver",
      "libXtst",
      "xdg-utils",
      "at-spi2-core",
      "libdrm",
      "mesa-libgbm",
      "alsa-lib",
      "tar",
      "xz"
    ]
  },
  "pacman": {
    "packageName": "linux-jagex-launcher",
    "artifactName": "linux-jagex-launcher-${version}.${arch}.${ext}",
    "compression": "xz",
    "fpm": [
      "--replaces=jagex-launcher",
      "--conflicts=jagex-launcher",
      "--provides=jagex-launcher"
    ],
    "depends": [
      "gtk3",
      "nss",
      "libxss",
      "libxtst",
      "xdg-utils",
      "at-spi2-core",
      "libdrm",
      "mesa",
      "alsa-lib",
      "tar",
      "xz"
    ]
  }
}
