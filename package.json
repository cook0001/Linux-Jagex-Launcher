{
  "name": "linux-jagex-launcher",
  "version": "1.3.0",
  "description": "Authentic, native Jagex Launcher for Linux supporting RuneScape 3 and Old School RuneScape (RuneLite, HDOS, Official Client).",
  "desktopName": "linux-jagex-launcher",
  "main": "dist/main/index.js",
  "homepage": "https://cook0001.github.io/Linux-Jagex-Launcher/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cook0001/Linux-Jagex-Launcher.git"
  },
  "bugs": {
    "url": "https://github.com/cook0001/Linux-Jagex-Launcher/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "qc": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preflight": "npm run qc",
    "dist": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "runescape",
    "oldschool-runescape",
    "osrs",
    "rs3",
    "runescape3",
    "jagex",
    "jagex-launcher",
    "runelite",
    "hdos",
    "dragonwilds",
    "linux",
    "flatpak",
    "appimage",
    "steamdeck",
    "steamos",
    "electron",
    "gaming-on-linux"
  ],
  "author": "Daniel Cook",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.85.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
