  "main": "dist/main/index.js",
  "homepage": "https://cook0001.github.io/Linux-Jagex-Launcher/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cook0001/Linux-Jagex-Launcher.git"
  },
  "bugs": {
    "url": "https://github.com/cook0001/Linux-Jagex-Launcher/issues"
  },
  "scripts": {
